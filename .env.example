import os

def ask_api_keys():
    print("🔐 Enter your API keys below (press Enter to skip any optional ones):\n")

    keys = {
        "GROQ_API_KEY": input("Groq API Key: ").strip(),
        "OPENAI_API_KEY": input("OpenAI API Key: ").strip(),
        "SERPER_API": input("Serper API Key: ").strip(),
        "BRAVE_SEARCH_API_KEY": input("Brave Search API Key (optional): ").strip(),
        "OLLAMA_BASE_URL": input("Ollama Base URL (default http://localhost:11434/v1): ").strip() or "http://localhost:11434/v1",
        "UPSTASH_REDIS_REST_URL": input("Upstash Redis REST URL (optional): ").strip(),
        "UPSTASH_REDIS_REST_TOKEN": input("Upstash Redis Token (optional): ").strip(),
        "GOOGLE_SEARCH_API_KEY": input("Google Search API Key (optional): ").strip(),
        "GOOGLE_CX": input("Google CX (optional): ").strip(),
        "PORTKEY_API_KEY": input("Portkey API Key (optional): ").strip(),
        "PORTKEY_BEDROCK_VIRTUAL_KEY": input("Portkey Bedrock Virtual Key (optional): ").strip(),
        "SPOTIFY_CLIENT_ID": input("Spotify Client ID (optional): ").strip(),
        "SPOTIFY_CLIENT_SECRET": input("Spotify Client Secret (optional): ").strip(),
        "AWS_ACCESS_KEY_ID": input("AWS Access Key ID (optional): ").strip(),
        "AWS_SECRET_ACCESS_KEY": input("AWS Secret Access Key (optional): ").strip(),
        "FAL_KEY": input("FAL.AI Key (optional): ").strip()
    }

    # Set each key in environment variables
    for key, value in keys.items():
        if value:
            os.environ[key] = value

    print("\n✅ All keys have been set for this session (not saved permanently).")

# Example: use your keys later in the same script
if __name__ == "__main__":
    ask_api_keys()

    # Example usage
    if os.getenv("OPENAI_API_KEY"):
        print("\n🔎 OpenAI Key Loaded Successfully:", os.getenv("OPENAI_API_KEY")[:8] + "********")
    else:
        print("\n⚠️ No OpenAI key provided.")
